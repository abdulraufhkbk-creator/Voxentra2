{
  "manifest_version": 3,
  "name": "Voxentra - Social Intelligence Companion",
  "version": "1.0.0",
  "description": "Privacy-first social intelligence analyzer. Analyze public content, detect synthetic media, and understand information spread.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voxentra Quick Intel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.x.com/*",
        "https://*.twitter.com/*",
        "https://*.reddit.com/*",
        "https://*.youtube.com/*",
        "https://*.facebook.com/*",
        "https://web.telegram.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
