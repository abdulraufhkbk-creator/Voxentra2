# =============================================================================
# VOXENTRA Social Intelligence Analyzer - Environment Configuration
# =============================================================================

# --- GEMINI AI (Server-Side) ---
# Automatically injected at runtime in Google AI Studio from user secrets.
# Used for server-side multi-modal analysis, language inference, and risk synthesis.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- APPLICATION PUBLIC URL ---
# Automatically injected at runtime by Cloud Run.
APP_URL="MY_APP_URL"

# --- SERVER CONFIGURATION ---
PORT=3000
NODE_ENV="development"

# --- SUPABASE POSTGRESQL (Active Integration) ---
# Used as the primary persistent data layer for analyses, reports, topics, and signals.
# Falls back to local persistent storage (data/voxentra_store.json) if credentials are not set.
SUPABASE_URL=""
SUPABASE_SECRET_KEY=""

# --- ACTIVE PLATFORM CONNECTORS ---

# YouTube Data API v3 (Active Live Connector)
VOXENTRA_YOUTUBE_API_KEY=""

# Telegram Bot API & MTProto (Active Live Connector)
VOXENTRA_TELEGRAM_API_ID=""
VOXENTRA_TELEGRAM_API_HASH=""
VOXENTRA_TELEGRAM_BOT_TOKEN=""

# X (Twitter) API v2 (Active Live Connector)
VOXENTRA_X_BEARER_TOKEN=""
VOXENTRA_X_API_KEY=""
VOXENTRA_X_API_SECRET=""

# Note: Instagram, Facebook, and Reddit are currently configured in Seeded/Demo Mode
# and do not require external credentials.
